{
  "name": "mono-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Small agent framework building blocks under the @worklab-ai scope.",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --sort run build && pnpm run build:demo",
    "check:architecture": "node scripts/check-package-architecture.mjs",
    "build:demo": "tsc -p demos/final-agent/tsconfig.build.json && tsc -p demos/multi-agent/tsconfig.build.json && tsc -p demos/agents-sdk-demo/tsconfig.build.json && tsc -p demos/downloads-curator/tsconfig.build.json",
    "typecheck": "pnpm -r --sort run typecheck && pnpm run typecheck:demo",
    "typecheck:demo": "tsc -p demos/final-agent/tsconfig.json --noEmit && tsc -p demos/multi-agent/tsconfig.json --noEmit && tsc -p demos/agents-sdk-demo/tsconfig.json --noEmit && tsc -p demos/downloads-curator/tsconfig.json --noEmit",
    "test": "pnpm -r --sort run test && pnpm run test:demo",
    "test:demo": "vitest run --passWithNoTests demos/final-agent/src/__tests__/final-demo.test.ts demos/final-agent/src/__tests__/cli-args.test.ts demos/final-agent/src/__tests__/deployment.test.ts demos/multi-agent/src/__tests__/cli-args.test.ts demos/multi-agent/src/__tests__/deployment.test.ts demos/multi-agent/src/__tests__/multi-agent-demo.test.ts demos/downloads-curator/src/__tests__/downloads-tools.test.ts demos/downloads-curator/src/__tests__/downloads-curator.test.ts",
    "demo:final": "node demos/final-agent/dist/cli.js",
    "deploy:final": "pnpm run build && node demos/final-agent/dist/deploy-cli.js",
    "demo:multi": "node demos/multi-agent/dist/cli.js",
    "deploy:multi": "pnpm run build && node demos/multi-agent/dist/deploy-cli.js",
    "demo:agents-sdk": "node demos/agents-sdk-demo/dist/cli.js",
    "demo:downloads": "node demos/downloads-curator/dist/cli.js",
    "deploy:downloads": "tsc -p demos/downloads-curator/tsconfig.build.json && node demos/downloads-curator/dist/deploy-cli.js"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^22.15.18",
    "@vitest/coverage-v8": "3.2.4",
    "@worklab-ai/a2a-adapter": "workspace:^0.1.0",
    "@worklab-ai/agent-contracts": "workspace:^0.1.0",
    "@worklab-ai/agent-evals": "workspace:^0.1.0",
    "@worklab-ai/agent-harness": "workspace:^0.1.0",
    "@worklab-ai/agent-host": "workspace:^0.1.0",
    "@worklab-ai/agent-orchestrator": "workspace:^0.1.0",
    "@worklab-ai/claude-agents-runtime": "workspace:^0.1.0",
    "@worklab-ai/codex-app-runtime": "workspace:^0.1.0",
    "@worklab-ai/config": "workspace:^0.1.0",
    "@worklab-ai/context": "workspace:^0.1.0",
    "@worklab-ai/cron-adapter": "workspace:^0.1.0",
    "@worklab-ai/memory-md": "workspace:^0.1.0",
    "@worklab-ai/observability": "workspace:^0.1.0",
    "@worklab-ai/openai-api-adapter": "workspace:^0.1.0",
    "@worklab-ai/openai-agents-runtime": "workspace:^0.1.0",
    "@worklab-ai/operator-console": "workspace:^0.1.0",
    "@worklab-ai/runtime-adapter": "workspace:^0.1.0",
    "@worklab-ai/settings": "workspace:^0.1.0",
    "@worklab-ai/slack-adapter": "workspace:^0.1.0",
    "@worklab-ai/telegram-adapter": "workspace:^0.1.0",
    "@worklab-ai/tool-policy": "workspace:^0.1.0",
    "@worklab-ai/tui": "workspace:^0.1.0",
    "@worklab-ai/webhook-adapter": "workspace:^0.1.0",
    "@worklab-ai/whatsapp-adapter": "workspace:^0.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
