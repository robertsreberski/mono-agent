{
  "name": "mono-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Small agent framework building blocks under the @mono-agent scope.",
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r --sort run build && pnpm run build:demo",
    "check:architecture": "node scripts/check-package-architecture.mjs",
    "build:demo": "tsc -p demos/final-agent/tsconfig.build.json && tsc -p demos/multi-agent/tsconfig.build.json && tsc -p demos/downloads-curator/tsconfig.build.json",
    "typecheck": "pnpm -r --sort run typecheck && pnpm run typecheck:demo",
    "typecheck:demo": "tsc -p demos/final-agent/tsconfig.json --noEmit && tsc -p demos/multi-agent/tsconfig.json --noEmit && tsc -p demos/downloads-curator/tsconfig.json --noEmit",
    "test": "pnpm run release:test && pnpm -r --sort run test && pnpm run test:demo",
    "test:demo": "vitest run --passWithNoTests demos/final-agent/src/__tests__/final-demo.test.ts demos/final-agent/src/__tests__/cli-args.test.ts demos/final-agent/src/__tests__/deployment.test.ts demos/multi-agent/src/__tests__/cli-args.test.ts demos/multi-agent/src/__tests__/deployment.test.ts demos/multi-agent/src/__tests__/multi-agent-demo.test.ts demos/downloads-curator/src/__tests__/downloads-tools.test.ts demos/downloads-curator/src/__tests__/downloads-curator.test.ts",
    "demo:final": "node demos/final-agent/dist/cli.js",
    "deploy:final": "pnpm run build && node demos/final-agent/dist/deploy-cli.js",
    "demo:multi": "node demos/multi-agent/dist/cli.js",
    "deploy:multi": "pnpm run build && node demos/multi-agent/dist/deploy-cli.js",
    "demo:downloads": "node demos/downloads-curator/dist/cli.js",
    "deploy:downloads": "tsc -p demos/downloads-curator/tsconfig.build.json && node demos/downloads-curator/dist/deploy-cli.js",
    "release:validate": "node scripts/release/validate-release.mjs",
    "release:pack": "node scripts/release/pack-release.mjs",
    "release:publish": "node scripts/release/publish-release.mjs",
    "release:verify": "node scripts/release/verify-release.mjs",
    "release:test": "vitest run scripts/release/__tests__/release.test.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^22.15.18",
    "@vitest/coverage-v8": "3.2.4",
    "@mono-agent/a2a-adapter": "workspace:0.3.0",
    "@mono-agent/agent-app": "workspace:0.3.0",
    "@mono-agent/agent-contracts": "workspace:0.3.0",
    "@mono-agent/agent-evals": "workspace:0.3.0",
    "@mono-agent/agent-harness": "workspace:0.3.0",
    "@mono-agent/agent-host": "workspace:0.3.0",
    "@mono-agent/agent-orchestrator": "workspace:0.3.0",
    "@mono-agent/config": "workspace:0.3.0",
    "@mono-agent/context": "workspace:0.3.0",
    "@mono-agent/cron-adapter": "workspace:0.3.0",
    "@mono-agent/memory-bujo": "workspace:0.3.0",
    "@mono-agent/memory-search": "workspace:0.3.0",
    "@mono-agent/memory-store": "workspace:0.3.0",
    "@mono-agent/observability": "workspace:0.3.0",
    "@mono-agent/observability-otel": "workspace:0.3.0",
    "@mono-agent/openai-api-adapter": "workspace:0.3.0",
    "@mono-agent/runtime-adapter": "workspace:0.3.0",
    "@mono-agent/sandbox": "workspace:0.3.0",
    "@mono-agent/settings": "workspace:0.3.0",
    "@mono-agent/slack-adapter": "workspace:0.3.0",
    "@mono-agent/telegram-adapter": "workspace:0.3.0",
    "@mono-agent/tool-policy": "workspace:0.3.0",
    "@mono-agent/tui": "workspace:0.3.0",
    "@mono-agent/webhook-adapter": "workspace:0.3.0",
    "@mono-agent/whatsapp-adapter": "workspace:0.3.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
