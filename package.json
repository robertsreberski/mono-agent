{
  "name": "mono-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Small agent framework building blocks under the @mono-agent scope.",
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r --sort run build && pnpm run build:demo",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:oss-hygiene": "node scripts/check-oss-hygiene.mjs",
    "check:codex-discoverability": "node scripts/check-codex-discoverability.mjs",
    "check:architecture": "node scripts/check-package-architecture.mjs",
    "verify:consumers": "node scripts/verify-consumers.mjs",
    "verify:all": "node scripts/verify-all.mjs",
    "build:demo": "tsc -p demos/final-agent/tsconfig.build.json",
    "typecheck": "pnpm -r --sort run typecheck && pnpm run typecheck:demo",
    "typecheck:demo": "tsc -p demos/final-agent/tsconfig.json --noEmit",
    "test": "pnpm run release:test && pnpm run scripts:test && pnpm -r --sort run test && pnpm run test:demo",
    "test:demo": "vitest run --passWithNoTests demos/final-agent/src/__tests__/final-demo.test.ts demos/final-agent/src/__tests__/cli-args.test.ts demos/final-agent/src/__tests__/deployment.test.ts",
    "demo:final": "node demos/final-agent/dist/cli.js",
    "deploy:final": "pnpm run build && node demos/final-agent/dist/deploy-cli.js",
    "release:validate": "node scripts/release/validate-release.mjs",
    "release:pack": "node scripts/release/pack-release.mjs",
    "release:publish": "node scripts/release/publish-release.mjs",
    "release:verify": "node scripts/release/verify-release.mjs",
    "scripts:test": "vitest run scripts/__tests__/*.test.mjs",
    "release:test": "vitest run scripts/release/__tests__/release.test.mjs scripts/release/__tests__/package-count-drift.test.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^22.15.18",
    "@vitest/coverage-v8": "3.2.4",
    "@mono-agent/a2a-adapter": "workspace:0.4.0",
    "@mono-agent/agent-app": "workspace:0.4.0",
    "@mono-agent/agent-contracts": "workspace:0.4.0",
    "@mono-agent/agent-harness": "workspace:0.4.0",
    "@mono-agent/agent-host": "workspace:0.4.0",
    "@mono-agent/agent-orchestrator": "workspace:0.4.0",
    "@mono-agent/config": "workspace:0.4.0",
    "@mono-agent/context": "workspace:0.4.0",
    "@mono-agent/cron-adapter": "workspace:0.4.0",
    "@mono-agent/memory": "workspace:0.4.0",
    "@mono-agent/observability": "workspace:0.4.0",
    "@mono-agent/openai-api-adapter": "workspace:0.4.0",
    "@mono-agent/runtime-adapter": "workspace:0.4.0",
    "@mono-agent/sandbox": "workspace:0.4.0",
    "@mono-agent/slack-adapter": "workspace:0.4.0",
    "@mono-agent/telegram-adapter": "workspace:0.4.0",
    "@mono-agent/tool-policy": "workspace:0.4.0",
    "@mono-agent/tui": "workspace:0.4.0",
    "@mono-agent/tui-adapter": "workspace:0.4.0",
    "@mono-agent/webhook-adapter": "workspace:0.4.0",
    "@mono-agent/whatsapp-adapter": "workspace:0.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
