{
  "name": "@mono-agent/app",
  "version": "0.26.0",
  "description": "Config-first mono-agent host: builds a responder and starts every configured communication channel and traceability from one mono-agent.config.json.",
  "type": "module",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertsreberski/mono-agent.git",
    "directory": "packages/app"
  },
  "private": false,
  "engines": {
    "node": ">=24.15.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "mono-agent": "./dist/cli.js"
  },
  "files": [
    "dist",
    "resources",
    "schema",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@clack/prompts": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@mono-agent/contracts": "workspace:0.26.0",
    "@mono-agent/conversation": "workspace:0.26.0",
    "@mono-agent/turn": "workspace:0.26.0",
    "@mono-agent/config": "workspace:0.26.0",
    "@mono-agent/trigger-cron": "workspace:0.26.0",
    "@mono-agent/channel-operator": "workspace:0.26.0",
    "@mono-agent/memory": "workspace:0.26.0",
    "@mono-agent/observability": "workspace:0.26.0",
    "@mono-agent/channel-openai-api": "workspace:0.26.0",
    "@mono-agent/channel-slack": "workspace:0.26.0",
    "@mono-agent/channel-telegram": "workspace:0.26.0",
    "@mono-agent/web": "workspace:0.26.0",
    "@mono-agent/trigger-webhook": "workspace:0.26.0",
    "undici": "8.12.2",
    "yaml": "^2.9.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@mono-agent/channel-a2a": "workspace:0.26.0",
    "@mono-agent/channel-whatsapp": "workspace:0.26.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
