{
  "name": "@mono-agent/cron-adapter",
  "version": "0.10.0",
  "description": "Cron-based scheduled invocation adapter for agent responders.",
  "type": "module",
  "license": "UNLICENSED",
  "private": false,
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
