    },
    "rootDir": "src",
    "outDir": "dist",
    "declarationDir": "types"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.mts"
  ],
  "exclude": [
    "src/**/__tests__/**"
  ]
}
