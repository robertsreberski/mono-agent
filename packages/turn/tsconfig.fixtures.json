{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "../../.worklab-tmp/turn-test-fixtures"
  },
  "include": [
    "src/**/__tests__/**/fixtures/**/*.mts"
  ]
}
