{
  "name": "@mono-agent/turn",
  "version": "0.26.0",
  "description": "Agent runtime backed by the Pi SDK provider catalog",
  "type": "module",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertsreberski/mono-agent.git",
    "directory": "packages/turn"
  },
  "keywords": [
    "ai",
    "agents",
    "runtime",
    "mono-agent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "default": "./dist/ai/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "default": "./dist/agent/index.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "default": "./dist/host/index.js"
    },
    "./host/config": {
      "types": "./dist/host/config.d.ts",
      "default": "./dist/host/config.js"
    },
    "./host/types": {
      "types": "./dist/host/types.d.ts",
      "default": "./dist/host/types.js"
    },
    "./host/sandbox": {
      "types": "./dist/host/sandbox/index.d.ts",
      "default": "./dist/host/sandbox/index.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "default": "./dist/engine/index.js"
    },
    "./engine/sessions.js": {
      "types": "./dist/engine/sessions.d.ts",
      "default": "./dist/engine/sessions.js"
    },
    "./engine/owned-fs.js": {
      "types": "./dist/engine/owned-fs.d.ts",
      "default": "./dist/engine/owned-fs.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "default": "./dist/tools/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "prepack": "pnpm run build",
    "test": "pnpm run build && node scripts/emit-test-fixtures.mjs && vitest run",
    "test:fixtures": "node scripts/emit-test-fixtures.mjs",
    "compare:public-types": "node scripts/compare-public-declarations.mjs"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.mjs",
    "dist/**/*.d.ts",
    "dist/**/*.d.mts",
    "!dist/**/__tests__/**",
    "!dist/**/fixtures/**",
    "ARCHITECTURE.md",
    "MIGRATION.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "ENGINE.md"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@mozilla/readability": "0.6.0",
    "@vscode/ripgrep": "1.18.0",
    "bmp-ts": "1.0.9",
    "defuddle": "0.19.4",
    "fast-xml-parser": "5.11.1",
    "linkedom": "0.18.13",
    "robots-parser": "3.0.1",
    "sharp": "0.35.5",
    "turndown": "7.2.4",
    "unpdf": "1.8.1",
    "zod": "^4.3.6",
    "@mono-agent/contracts": "workspace:0.26.0",
    "@earendil-works/pi-agent-core": "1.2.0"
  },
  "devDependencies": {
    "@types/turndown": "5.0.6"
  },
  "imports": {
    "#turn/runtime/retry-defaults": {
      "types": "./dist/runtime/retry-defaults.d.ts",
      "default": "./dist/runtime/retry-defaults.js"
    },
    "#turn/contracts/runtime": {
      "types": "./dist/contracts/runtime.d.ts",
      "default": "./dist/contracts/runtime.js"
    },
    "#turn/telemetry/cost": {
      "types": "./dist/telemetry/cost.d.ts",
      "default": "./dist/telemetry/cost.js"
    },
    "#turn/contracts/native-storage": {
      "types": "./dist/contracts/native-storage.d.ts",
      "default": "./dist/contracts/native-storage.js"
    },
    "#turn/contracts/events": {
      "types": "./dist/contracts/events.d.ts",
      "default": "./dist/contracts/events.js"
    },
    "#turn/contracts/live-input": {
      "types": "./dist/contracts/live-input.d.ts",
      "default": "./dist/contracts/live-input.js"
    },
    "#turn/contracts/mcp-apps": {
      "types": "./dist/contracts/mcp-apps.d.ts",
      "default": "./dist/contracts/mcp-apps.js"
    },
    "#turn/contracts/session": {
      "types": "./dist/contracts/session.d.ts",
      "default": "./dist/contracts/session.js"
    },
    "#turn/contracts/process": {
      "types": "./dist/contracts/process.d.ts",
      "default": "./dist/contracts/process.js"
    },
    "#turn/contracts/policy": {
      "types": "./dist/contracts/policy.d.ts",
      "default": "./dist/contracts/policy.js"
    },
    "#turn/runtime/create-runtime": {
      "types": "./dist/runtime/create-runtime.d.ts",
      "default": "./dist/runtime/create-runtime.js"
    },
    "#turn/runtime/router": {
      "types": "./dist/runtime/router.d.ts",
      "default": "./dist/runtime/router.js"
    },
    "#turn/runtime/model-reference": {
      "types": "./dist/runtime/model-reference.d.ts",
      "default": "./dist/runtime/model-reference.js"
    },
    "#turn/runtime/bridges": {
      "types": "./dist/runtime/bridges.d.ts",
      "default": "./dist/runtime/bridges.js"
    },
    "#turn/providers/pi/catalog": {
      "types": "./dist/providers/pi/catalog.d.ts",
      "default": "./dist/providers/pi/catalog.js"
    },
    "#turn/providers/pi/context-1m": {
      "types": "./dist/providers/pi/context-1m.d.ts",
      "default": "./dist/providers/pi/context-1m.js"
    }
  }
}
