{
  "name": "@mono-agent/turn",
  "version": "0.25.1",
  "description": "Agent runtime backed by the Pi SDK provider catalog",
  "type": "module",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertsreberski/mono-agent.git",
    "directory": "packages/turn"
  },
  "keywords": [
    "ai",
    "agents",
    "runtime",
    "mono-agent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./ai": {
      "types": "./types/ai/index.d.ts",
      "default": "./src/ai/index.js"
    },
    "./agent": {
      "types": "./types/agent/index.d.ts",
      "default": "./src/agent/index.js"
    },
    "./host": {
      "types": "./types/host/index.d.ts",
      "default": "./dist/host/index.js"
    },
    "./host/config": {
      "types": "./types/host/config.d.ts",
      "default": "./dist/host/config.js"
    },
    "./host/types": {
      "types": "./types/host/types.d.ts",
      "default": "./dist/host/types.js"
    },
    "./host/sandbox": {
      "types": "./types/host/sandbox.d.ts",
      "default": "./dist/host/sandbox.js"
    },
    "./engine": {
      "types": "./types/engine/index.d.ts",
      "default": "./src/engine/index.js"
    },
    "./engine/sessions.js": {
      "types": "./types/engine/sessions.d.ts",
      "default": "./src/engine/sessions.js"
    },
    "./engine/owned-fs.js": {
      "types": "./types/engine/owned-fs.d.ts",
      "default": "./src/engine/owned-fs.js"
    },
    "./tools": {
      "types": "./types/tools/index.d.ts",
      "default": "./src/tools/index.js"
    }
  },
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.types.json && tsc -p tsconfig.host.build.json && node -e \"require('node:fs').copyFileSync('src/host/srt-embed-runner.mjs','dist/host/srt-embed-runner.mjs')\"",
    "typecheck": "tsc -p tsconfig.types.json --noEmit && tsc -p tsconfig.host.json --noEmit",
    "prepack": "pnpm run build",
    "test": "vitest run"
  },
  "files": [
    "src/**/*.js",
    "!src/__tests__/**",
    "!src/engine/__tests__/**",
    "types/**/*.d.ts",
    "ARCHITECTURE.md",
    "MIGRATION.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "dist/host/**/*.js",
    "!dist/host/**/__tests__/**",
    "dist/host/srt-embed-runner.mjs",
    "ENGINE.md"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@mozilla/readability": "0.6.0",
    "@vscode/ripgrep": "1.18.0",
    "bmp-ts": "1.0.9",
    "defuddle": "0.19.4",
    "fast-xml-parser": "5.11.1",
    "linkedom": "0.18.13",
    "robots-parser": "3.0.1",
    "sharp": "0.35.5",
    "turndown": "7.2.4",
    "unpdf": "1.8.1",
    "zod": "^4.3.6",
    "@mono-agent/contracts": "workspace:0.25.1",
    "@earendil-works/pi-agent-core": "1.2.0"
  },
  "devDependencies": {
    "@types/turndown": "5.0.6"
  },
  "imports": {
    "#kernel/types": {
      "types": "./types/contracts/runtime.d.ts",
      "default": "./src/contracts/runtime.js"
    },
    "#kernel/cost": {
      "types": "./types/ai/cost.d.ts",
      "default": "./src/ai/cost.js"
    },
    "#kernel/native-journal-types": {
      "types": "./types/ai/native-journal-types.d.ts",
      "default": "./src/ai/native-journal-types.js"
    },
    "#turn/contracts/events": {
      "types": "./types/contracts/events.d.ts",
      "default": "./src/contracts/events.js"
    },
    "#turn/contracts/live-input": {
      "types": "./types/contracts/live-input.d.ts",
      "default": "./src/contracts/live-input.js"
    },
    "#turn/contracts/mcp-apps": {
      "types": "./types/contracts/mcp-apps.d.ts",
      "default": "./src/contracts/mcp-apps.js"
    },
    "#turn/contracts/session": {
      "types": "./types/contracts/session.d.ts",
      "default": "./src/contracts/session.js"
    },
    "#turn/contracts/process": {
      "types": "./types/contracts/process.d.ts",
      "default": "./src/contracts/process.js"
    },
    "#turn/contracts/policy": {
      "types": "./types/contracts/policy.d.ts",
      "default": "./src/contracts/policy.js"
    },
    "#turn/runtime/create-runtime": {
      "types": "./types/runtime.d.ts",
      "default": "./src/runtime.js"
    },
    "#turn/runtime/router": {
      "types": "./types/ai/runtime/router.d.ts",
      "default": "./src/ai/runtime/router.js"
    },
    "#turn/runtime/model-reference": {
      "types": "./types/ai/runtime/model-refs.d.ts",
      "default": "./src/ai/runtime/model-refs.js"
    },
    "#turn/runtime/bridges": {
      "types": "./types/ai/runtime/registry.d.ts",
      "default": "./src/ai/runtime/registry.js"
    },
    "#turn/providers/pi/catalog": {
      "types": "./types/ai/pi-interop.d.ts",
      "default": "./src/ai/pi-interop.js"
    },
    "#turn/providers/pi/context-1m": {
      "types": "./types/ai/context-1m.d.ts",
      "default": "./src/ai/context-1m.js"
    }
  }
}
