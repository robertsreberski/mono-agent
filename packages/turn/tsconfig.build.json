{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "declaration": true,
    "emitDeclarationOnly": false,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmitOnError": true,
    "paths": {
      "#turn/runtime/retry-defaults": [
        "./src/runtime/retry-defaults.ts"
      ],
      "#turn/contracts/runtime": [
        "./src/contracts/runtime.ts"
      ],
      "#turn/telemetry/cost": [
        "./src/telemetry/cost.ts"
      ],
      "#turn/contracts/native-storage": [
        "./src/contracts/native-storage.ts"
      ],
      "#turn/contracts/events": [
        "./src/contracts/events.ts"
      ],
      "#turn/contracts/live-input": [
        "./src/contracts/live-input.ts"
      ],
      "#turn/contracts/mcp-apps": [
        "./src/contracts/mcp-apps.ts"
      ],
      "#turn/contracts/session": [
        "./src/contracts/session.ts"
      ],
      "#turn/contracts/process": [
        "./src/contracts/process.ts"
      ],
      "#turn/contracts/policy": [
        "./src/contracts/policy.ts"
      ],
      "#turn/runtime/create-runtime": [
        "./src/runtime/create-runtime.ts"
      ],
      "#turn/runtime/router": [
        "./src/runtime/router.ts"
      ],
      "#turn/runtime/model-reference": [
        "./src/runtime/model-reference.ts"
      ],
      "#turn/runtime/bridges": [
        "./src/runtime/bridges.ts"
      ],
      "#turn/providers/pi/catalog": [
        "./src/providers/pi/catalog.ts"
      ],
      "#turn/providers/pi/context-1m": [
        "./src/providers/pi/context-1m.ts"
      ]
    },
    "verbatimModuleSyntax": true
  },
  "include": [
    "src/**/*.js",
    "src/**/*.ts",
    "src/**/*.mts"
  ],
  "exclude": [
    "src/**/__tests__/**"
  ]
}
