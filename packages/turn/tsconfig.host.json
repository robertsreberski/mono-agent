{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declarationDir": "types",
    "tsBuildInfoFile": "dist/.host.tsbuildinfo",
    "paths": {
      "#kernel/types": [
        "./types/contracts/runtime.d.ts"
      ],
      "#kernel/cost": [
        "./types/ai/cost.d.ts"
      ],
      "#kernel/native-journal-types": [
        "./types/ai/native-journal-types.d.ts"
      ],
      "#turn/contracts/events": [
        "./types/contracts/events.d.ts"
      ],
      "#turn/contracts/live-input": [
        "./types/contracts/live-input.d.ts"
      ],
      "#turn/contracts/mcp-apps": [
        "./types/contracts/mcp-apps.d.ts"
      ],
      "#turn/contracts/session": [
        "./types/contracts/session.d.ts"
      ],
      "#turn/contracts/process": [
        "./types/contracts/process.d.ts"
      ],
      "#turn/contracts/policy": [
        "./types/contracts/policy.d.ts"
      ],
      "#turn/runtime/create-runtime": [
        "./types/runtime.d.ts"
      ],
      "#turn/runtime/router": [
        "./types/ai/runtime/router.d.ts"
      ],
      "#turn/runtime/model-reference": [
        "./types/ai/runtime/model-refs.d.ts"
      ],
      "#turn/runtime/bridges": [
        "./types/ai/runtime/registry.d.ts"
      ],
      "#turn/providers/pi/catalog": [
        "./types/ai/pi-interop.d.ts"
      ],
      "#turn/providers/pi/context-1m": [
        "./types/ai/context-1m.d.ts"
      ]
    }
  },
  "include": [
    "src/host/**/*.ts"
  ]
}
