{
  "name": "@mono-agent/web",
  "version": "0.26.0",
  "description": "Always-on assistant-ui web console for discovering and chatting with local mono-agent instances.",
  "type": "module",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertsreberski/mono-agent.git",
    "directory": "packages/web"
  },
  "private": false,
  "engines": {
    "node": ">=24.15.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/console-api.v1.schema.json": "./schema/console-api.v1.schema.json",
    "./schema/console-api.v1.routes.json": "./schema/console-api.v1.routes.json",
    "./schema/console-api.v1.fixtures.json": "./schema/console-api.v1.fixtures.json",
    "./schema/message-delta-vectors.v1.json": "./schema/message-delta-vectors.v1.json"
  },
  "files": [
    "dist",
    "schema",
    "webapp/dist",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm --dir webapp install --frozen-lockfile && pnpm --dir webapp run build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.contract.json && pnpm --dir webapp run typecheck:storybook",
    "test": "pnpm run check:api-contract && vitest run src/__tests__ && pnpm --dir webapp run test",
    "generate:api-contract": "node scripts/generate-api-contract.mjs",
    "check:api-contract": "node scripts/generate-api-contract.mjs --check"
  },
  "dependencies": {
    "@mono-agent/channel-operator": "workspace:0.26.0",
    "@mono-agent/config": "workspace:0.26.0",
    "@mono-agent/contracts": "workspace:0.26.0",
    "@mono-agent/observability": "workspace:0.26.0",
    "compression": "1.8.2",
    "cron-parser": "5.5.0",
    "express": "^5.1.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@mono-agent/conversation": "workspace:0.26.0",
    "@mono-agent/turn": "workspace:0.26.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.2",
    "@types/web-push": "3.6.4",
    "ajv": "^8.20.0",
    "ts-json-schema-generator": "^2.9.0",
    "undici": "8.12.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
