{
  "name": "@mono-agent/web",
  "version": "0.20.1",
  "description": "Always-on assistant-ui web console for discovering and chatting with local mono-agent instances.",
  "type": "module",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertsreberski/mono-agent.git",
    "directory": "packages/web"
  },
  "private": false,
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "webapp/dist",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run build:webapp && pnpm run build:server",
    "build:server": "tsc -p tsconfig.build.json",
    "build:webapp": "pnpm --dir webapp install --frozen-lockfile && pnpm --dir webapp run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src/__tests__ && pnpm --dir webapp run test"
  },
  "dependencies": {
    "@mono-agent/agent-contracts": "workspace:0.20.1",
    "@mono-agent/config": "workspace:0.20.1",
    "@mono-agent/observability": "workspace:0.20.1",
    "express": "^5.1.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/web-push": "3.6.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
