{
  "name": "@worklab-ai/config-ui-demo",
  "version": "0.1.0",
  "description": "Private local demo host for the Mono Agent config UI bridge.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mono-agent-config-ui": "./dist/cli.js"
  },
  "exports": {
    ".": {
