    "@mono-agent/memory-search": "workspace:0.4.0",
    "@mono-agent/memory-store": "workspace:0.4.0",
    "@mono-agent/memory-supermemory": "workspace:0.4.0",
    "@mono-agent/observability": "workspace:0.4.0",
    "@mono-agent/runtime-adapter": "workspace:0.4.0",
    "@mono-agent/sandbox": "workspace:0.4.0",
    "@mono-agent/tool-policy": "workspace:0.4.0"
  },
  "publishConfig": {
    "access": "public"
