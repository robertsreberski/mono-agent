{
  "name": "@mono-agent/agent-host",
  "version": "0.4.0",
  "description": "Host composition helpers for agent responders.",
  "type": "module",
  "license": "UNLICENSED",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
