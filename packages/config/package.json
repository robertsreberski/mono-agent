{
  "name": "@worklab-ai/config",
  "version": "0.1.0",
  "description": "Strict environment/file config parser for Mono Agent hosts.",
  "type": "module",
  "license": "UNLICENSED",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
