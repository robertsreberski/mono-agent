{
  "name": "@mono-agent/agent-app",
  "version": "0.2.0",
  "description": "Config-first mono-agent host: builds a responder and starts every configured communication channel, operator console, and traceability from one mono-agent.config.json.",
  "type": "module",
  "license": "UNLICENSED",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "mono-agent": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mono-agent/a2a-adapter": "workspace:0.2.0",
    "@mono-agent/agent-contracts": "workspace:0.2.0",
    "@mono-agent/agent-host": "workspace:0.2.0",
    "@mono-agent/config": "workspace:0.2.0",
    "@mono-agent/cron-adapter": "workspace:0.2.0",
    "@mono-agent/observability": "workspace:0.2.0",
    "@mono-agent/openai-api-adapter": "workspace:0.2.0",
    "@mono-agent/operator-console": "workspace:0.2.0",
    "@mono-agent/runtime-adapter": "workspace:0.2.0",
    "@mono-agent/settings": "workspace:0.2.0",
    "@mono-agent/slack-adapter": "workspace:0.2.0",
    "@mono-agent/telegram-adapter": "workspace:0.2.0",
    "@mono-agent/webhook-adapter": "workspace:0.2.0",
    "@mono-agent/whatsapp-adapter": "workspace:0.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
