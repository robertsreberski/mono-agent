  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@worklab-ai/agent-harness": "^0.1.0",
    "@worklab-ai/config": "^0.1.0",
    "@worklab-ai/memory-md": "^0.1.0",
    "@worklab-ai/observability": "^0.1.0",
    "@worklab-ai/runtime-adapter": "^0.1.0",
    "@worklab-ai/telegram-bridge": "^0.1.0",
    "@worklab-ai/tool-policy": "^0.1.0"
  }
}
