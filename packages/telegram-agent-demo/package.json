{
  "name": "@worklab-ai/telegram-agent-demo",
  "version": "0.1.0",
  "description": "Private local Telegram demo host for Mono Agent packages.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mono-agent-telegram-demo": "./dist/cli.js"
  },
  "exports": {
    ".": {
