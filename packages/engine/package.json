{
  "name": "@mono-agent/engine",
  "version": "0.25.1",
  "description": "Model-run loop, native journal storage and compaction for mono-agent",
  "type": "module",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertsreberski/mono-agent.git",
    "directory": "packages/engine"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sessions.js": {
      "types": "./dist/sessions.d.ts",
      "default": "./dist/sessions.js"
    },
    "./owned-fs.js": {
      "types": "./dist/owned-fs.d.ts",
      "default": "./dist/owned-fs.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-agent-core": "1.2.0"
  }
}
