---
import PenArt from "../site/PenArt.astro";
import IndexTab from "../site/IndexTab.astro";
import { FILES, escapeText } from "../../example-agent/files";
import { GITHUB_URL, RELEASE, TUTORIAL_URL } from "../../site-links.mjs";

// The note on the hero sheet is the example's real cron file. Wrap the same
// bytes the prototype highlights; textContent stays identical to the file.
const NOTE_PATH = "cron/morning-check.md";
const raw = FILES[NOTE_PATH];
const lines = raw.split("\n");
const close = lines.indexOf("---", 1);
if (lines[0] !== "---" || close < 0 || lines.length !== close + 3 || lines.at(-1) !== "") {
  throw new Error(`${NOTE_PATH} must be front matter followed by one instruction line.`);
}
const frontmatter = lines.slice(0, close + 1).map((line) => {
  const field = line.match(/^([A-Za-z]+):(.*)$/);
  if (!field) return escapeText(line);
  const [, key, value] = field;
  if (key === "expression" || key === "notify") return `<strong>${escapeText(`${key}:`)}</strong>${escapeText(value)}`;
  if (key === "model") return `${escapeText(`${key}:`)} <span class="sheet-model">${escapeText(value.trimStart())}</span>`;
  return escapeText(line);
});
const sheetHtml = `<span class="frontmatter">${frontmatter.join("\n")}</span>\n<span class="sheet-instruction">${escapeText(lines[close + 1])}</span>\n`;
---
<header class="cover">
  <h1><span>The coworker</span> <span>in a folder</span></h1>
  <p class="deck">Write the job down in a few plain files. Mono Agent runs that folder as an AI coworker you can reach from your laptop or your phone.</p>
  <div class="cover-side">
    <figure class="note-input">
      <figcaption class="note-caption">The note you wrote</figcaption>
      <div class="note-folder">
        <PenArt layer stretch class="hero-layer folder-manila" art="hero-manila" w={720} h={480} id="mask-hero-manila" />
        <PenArt layer stretch class="hero-layer folder-back" art="hero-back" w={720} h={480} id="mask-hero-back" />
        <div class="note-sheet paper-object">
          <PenArt layer stretch class="hero-layer sheet-stock" art="hero-sheet-edge" w={500} h={690} id="mask-hero-sheet-paper" />
          <PenArt layer stretch class="hero-layer sheet-ink" art="hero-sheet" w={500} h={690} id="mask-hero-sheet" />
          <div class="sheet-text">
            <p class="sheet-path">{NOTE_PATH}</p>
            <pre><code set:html={sheetHtml} /></pre>
            <div class="sheet-annotations">
              <span class="sheet-margin time-margin">Weekdays 8:00</span>
              <span class="sheet-margin send-margin">Sends the result</span>
            </div>
          </div>
        </div>
        <PenArt layer stretch class="hero-layer folder-stock" art="hero-pocket" w={720} h={480} id="mask-hero-pocket" />
        <PenArt layer stretch class="hero-layer folder-front" art="hero-front" w={720} h={480} id="mask-hero-front" />
        <p class="sheet-gloss">Weekdays at 8:00 · sends you the result</p>
      </div>
    </figure>
    <figure class="note-output">
      <figcaption class="note-caption">The note it left you</figcaption>
      <div class="note-slip paper-object">
        <PenArt layer stretch class="hero-layer slip-stock" art="slip-stock" w={720} h={412} id="mask-slip-stock" />
        <PenArt layer stretch class="hero-layer slip-ink" art="slip-ink" w={720} h={412} id="mask-slip-ink" />
        <div class="slip-head"><p>Payments maintainer</p><p class="slip-hour"><span class="slip-today">· Today </span><time datetime="08:00">08:00</time></p><span class="slip-example">Example</span></div>
        <div class="slip-body">
          <p><strong>Two tests failed overnight.</strong></p>
          <p><code>retry_after_timeout</code> is flaky — it passed on two reruns. Owner: Dana.</p>
          <p><code>refund_rounding</code> is a real failure that started with yesterday's currency change. Owner: Sam.</p>
        </div>
      </div>
    </figure>
  </div>
  <div class="start">
    <IndexTab class="index-tab primary-tab paper-object start-link" href={TUTORIAL_URL}>Build your first agent</IndexTab>
