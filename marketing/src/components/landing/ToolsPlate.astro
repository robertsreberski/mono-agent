---
import Plate from "./Plate.astro";
---
<Plate id="plate-v" numeral="V" headingId="title-v" title="Keep your tools. Add a coworker.">
  <figure class="selection-plate">
    <div class="figure-head"><b>Fig. 5 — Picking the right tool</b><span>Reach for it when you want…</span></div>
    <dl class="selection">
      <div class="mono-row"><dt>Mono Agent</dt><dd>a coworker you set up in files, reach from any device and share with your team.</dd></div>
      <div><dt>Claude Code</dt><dd>a coding agent you run from the command line in your repository.</dd></div>
      <div><dt>OpenClaw</dt><dd>an assistant you message from the chat apps you already use.</dd></div>
      <div><dt>Hermes Agent</dt><dd>a personal agent that picks up new skills as it goes.</dd></div>
      <div><dt>Mastra</dt><dd>a TypeScript framework for building your own agent apps.</dd></div>
    </dl>
    <figcaption class="figure-caption">Same files, not necessarily the same answers.</figcaption>
  </figure>
</Plate>
