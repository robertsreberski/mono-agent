---
import SiteLayout from "../layouts/SiteLayout.astro";
import Cover from "../components/landing/Cover.astro";
import Plate from "../components/landing/Plate.astro";
import FolderFigure from "../components/landing/FolderFigure.astro";
import ModelsPlate from "../components/landing/ModelsPlate.astro";
import ConsolePlate from "../components/landing/ConsolePlate.astro";
import MemoryPlate from "../components/landing/MemoryPlate.astro";
import ToolsPlate from "../components/landing/ToolsPlate.astro";
import SetupSheet from "../components/landing/SetupSheet.astro";
import { GITHUB_URL } from "../site-links.mjs";

// mono-agent marketing site — "The coworker in a folder", https://mono-agent.dev/.
//
// Copy rules for this page and the blog (BLOG.md points here):
// - Every claim was verified against the published v0.27.1 release (see
//   src/site-links.mjs). Do not add claims; a new claim needs the same
//   source check against the current release first. Never advertise
//   source-only capabilities as published, and never promise setup speed,
//   security, or availability.
// - The example folder (src/example-agent/) is real, validated config shown
//   byte-for-byte; its people, owners and test names are examples.
// - The console images are real console UI with an example conversation;
//   the ink drawings are decorative and never presented as product UI.
// - Visible copy never uses the words specimen, plate, terminal, coupon or
//   fictional (class names are not copy).
const SITE_URL = Astro.site!.origin;
const TITLE = "The coworker in a folder — Mono Agent";
const DESCRIPTION =
  "Set up an open-source AI coworker in plain files. Pick its models, teach it skills, and share the folder.";
const OG_IMAGE = `${SITE_URL}/og-1200x630.jpg`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite", "@id": `${SITE_URL}/#website`,
      url: `${SITE_URL}/`, name: "Mono Agent", alternateName: "mono-agent",
      description: DESCRIPTION, inLanguage: "en", about: { "@id": `${SITE_URL}/#software` },
    },
    {
      "@type": "WebPage", "@id": `${SITE_URL}/#webpage`,
      url: `${SITE_URL}/`, name: TITLE, description: DESCRIPTION, inLanguage: "en",
      isPartOf: { "@id": `${SITE_URL}/#website` }, mainEntity: { "@id": `${SITE_URL}/#software` },
      primaryImageOfPage: { "@type": "ImageObject", url: OG_IMAGE, width: 1200, height: 630 },
    },
    {
      "@type": "SoftwareSourceCode", "@id": `${SITE_URL}/#software`,
      name: "mono-agent", description: DESCRIPTION, url: `${SITE_URL}/`,
      codeRepository: GITHUB_URL, programmingLanguage: "TypeScript",
      runtimePlatform: "Node.js >=24.15.0", license: `${GITHUB_URL}/blob/main/LICENSE`,
      isAccessibleForFree: true,
    },
  ],
};
---
<SiteLayout title={TITLE} description={DESCRIPTION} path="/" jsonLd={jsonLd} home analytics>
  <script slot="head" is:inline type="module" src="/folder.js"></script>
  <Cover />
  <Plate id="plate-i" numeral="I" headingId="title-i" title="Everything it needs fits in one folder.">
    <FolderFigure />
  </Plate>
  <ModelsPlate />
  <ConsolePlate />
  <MemoryPlate />
  <ToolsPlate />
  <SetupSheet />
</SiteLayout>
