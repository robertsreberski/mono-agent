---
import ArrowIcon from "../components/ArrowIcon.astro";

// mono-agent marketing site — single static page for https://mono-agent.dev/.
//
// Copy rules for this file: every claim must already be true of the published
// baseline or be explicitly framed as configuration. Never advertise
// source-only capabilities as published (label them and link release status),
// never promise setup speed,
// security, or availability, and never present the decorative brand artwork
// as a product screenshot.
const SITE_URL = "https://mono-agent.dev";
const GITHUB_URL = "https://github.com/robertsreberski/mono-agent";
const DOCS_URL = "https://mono-agent-docs.vercel.app/";
const RELEASE_STATUS_URL = `${DOCS_URL}reference/release-status/`;
const CONFIG_URL = `${DOCS_URL}config/`;
const COMPOSITION_URL = `${DOCS_URL}programmatic/composition/`;
const MEMORY_URL = `${DOCS_URL}memory/`;
const FALLBACK_URL = `${DOCS_URL}runtime/fallback/`;
const ARTIFACTS_URL = `${DOCS_URL}observability/artifacts-and-traces/`;
const TOOLS_URL = `${DOCS_URL}tools/`;

const CONFIG_EXAMPLE = `{
  "runtime": {
    "model": "openai-codex:gpt-5.6-terra",
    "workspace": "."
  },
  "context": {
    "identityPath": "./IDENTITY.md",
    "skillsRoot": "./skills",
    "selectedSkills": ["code-review"]
  },
  "memory": {
    "mode": "lite",
    "writeMode": "append-host-summary"
  },
  "tools": {
    "allowedTools": ["Read", "Grep", "WebSearch"],
    "mcpConfigPath": "./mcp.json"
  },
  "telegram": {
    "enabled": true,
    "allowedChatIds": ["YOUR_CHAT_ID"]
  }
}`;

const TITLE = "mono-agent — Local-first AI workspace for coding and research";
const DESCRIPTION =
  "mono-agent is a local-first, config-first AI workspace for coding, research, and automation. One mono-agent.config.json defines your agent — models, tools, skills, memory, and channels. Open source (GPL-3.0).";
const OG_IMAGE = `${SITE_URL}/og-1200x630.jpg`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}/#website`,
      url: `${SITE_URL}/`,
      name: "mono-agent",
      description: DESCRIPTION,
    },
    {
      "@type": "Organization",
      "@id": `${SITE_URL}/#organization`,
      name: "mono-agent",
      url: `${SITE_URL}/`,
      logo: OG_IMAGE,
      sameAs: [GITHUB_URL],
    },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    <link rel="canonical" href={`${SITE_URL}/`} />
    <meta name="theme-color" content="#101211" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/manrope.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-serif-italic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/styles.css" />
    <script is:inline type="module" src="/interactions.js"></script>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="mono-agent" />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:url" content={`${SITE_URL}/`} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="mono-agent social card: the brand name and “Local-first AI workspace for coding and research” beside the sculptural matte stone artwork."
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={TITLE} />
    <meta name="twitter:description" content={DESCRIPTION} />
    <meta name="twitter:image" content={OG_IMAGE} />
    <meta
      name="twitter:image:alt"
      content="mono-agent social card: the brand name and “Local-first AI workspace for coding and research” beside the sculptural matte stone artwork."
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="#top" aria-label="mono-agent — back to top">
          <img src="/favicon.svg" alt="" width="30" height="30" aria-hidden="true" />
          <span>mono-agent</span>
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation" hidden><span>Menu</span><svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M3 7h14M3 13h14" /></svg></button>
        <nav class="site-nav" id="site-navigation" aria-label="Sections">
          <ul>
            <li><a href="#configuration">Blueprint</a></li>
            <li><a href="#console">Console</a></li>
            <li><a href="#comparison">Compare</a></li>
            <li><a href={DOCS_URL}>Docs <ArrowIcon /></a></li>
            <li class="mobile-github"><a href={GITHUB_URL}><svg class="github-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 .75a11.25 11.25 0 0 0-3.558 21.922c.563.104.768-.244.768-.542 0-.267-.01-.975-.015-1.914-3.13.68-3.791-1.508-3.791-1.508-.512-1.3-1.25-1.646-1.25-1.646-1.022-.7.078-.686.078-.686 1.13.08 1.724 1.16 1.724 1.16 1.005 1.722 2.638 1.225 3.28.937.102-.728.393-1.225.715-1.507-2.498-.284-5.124-1.25-5.124-5.562 0-1.228.439-2.233 1.159-3.02-.116-.285-.502-1.429.11-2.977 0 0 .945-.303 3.094 1.154A10.78 10.78 0 0 1 12 6.183c.956.004 1.919.129 2.819.378 2.148-1.457 3.092-1.154 3.092-1.154.614 1.548.228 2.692.112 2.977.722.787 1.158 1.792 1.158 3.02 0 4.324-2.63 5.275-5.136 5.553.404.35.766 1.043.766 2.101 0 1.518-.014 2.743-.014 3.115 0 .301.203.651.774.54A11.252 11.252 0 0 0 12 .75Z" /></svg>GitHub <ArrowIcon /></a></li>
          </ul>
        </nav>
        <div class="header-cta">

          <a class="btn btn-primary btn-small" href={GITHUB_URL}><svg class="github-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 .75a11.25 11.25 0 0 0-3.558 21.922c.563.104.768-.244.768-.542 0-.267-.01-.975-.015-1.914-3.13.68-3.791-1.508-3.791-1.508-.512-1.3-1.25-1.646-1.25-1.646-1.022-.7.078-.686.078-.686 1.13.08 1.724 1.16 1.724 1.16 1.005 1.722 2.638 1.225 3.28.937.102-.728.393-1.225.715-1.507-2.498-.284-5.124-1.25-5.124-5.562 0-1.228.439-2.233 1.159-3.02-.116-.285-.502-1.429.11-2.977 0 0 .945-.303 3.094 1.154A10.78 10.78 0 0 1 12 6.183c.956.004 1.919.129 2.819.378 2.148-1.457 3.092-1.154 3.092-1.154.614 1.548.228 2.692.112 2.977.722.787 1.158 1.792 1.158 3.02 0 4.324-2.63 5.275-5.136 5.553.404.35.766 1.043.766 2.101 0 1.518-.014 2.743-.014 3.115 0 .301.203.651.774.54A11.252 11.252 0 0 0 12 .75Z" /></svg>GitHub</a>
        </div>
      </div>
    </header>

    <main id="main">
      <section class="hero" id="top" aria-labelledby="hero-heading">
        <div class="wrap hero-grid">
          <div class="hero-copy">
            <span class="eyebrow">Independent by design / Config-first AI</span>
            <h1 id="hero-heading">Your agents. <br />Your models. <br /><em>Your workspace.</em></h1>
            <p class="lede">
              Compose models, tools, memory, and channels in
              <code>mono-agent.config.json</code>. Run the workspace—or build
              on the packages underneath.
            </p>
            <div class="hero-actions">
              <a class="btn btn-primary" href={GITHUB_URL}><svg class="github-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 .75a11.25 11.25 0 0 0-3.558 21.922c.563.104.768-.244.768-.542 0-.267-.01-.975-.015-1.914-3.13.68-3.791-1.508-3.791-1.508-.512-1.3-1.25-1.646-1.25-1.646-1.022-.7.078-.686.078-.686 1.13.08 1.724 1.16 1.724 1.16 1.005 1.722 2.638 1.225 3.28.937.102-.728.393-1.225.715-1.507-2.498-.284-5.124-1.25-5.124-5.562 0-1.228.439-2.233 1.159-3.02-.116-.285-.502-1.429.11-2.977 0 0 .945-.303 3.094 1.154A10.78 10.78 0 0 1 12 6.183c.956.004 1.919.129 2.819.378 2.148-1.457 3.092-1.154 3.092-1.154.614 1.548.228 2.692.112 2.977.722.787 1.158 1.792 1.158 3.02 0 4.324-2.63 5.275-5.136 5.553.404.35.766 1.043.766 2.101 0 1.518-.014 2.743-.014 3.115 0 .301.203.651.774.54A11.252 11.252 0 0 0 12 .75Z" /></svg>GitHub <ArrowIcon /></a>
              <a class="btn btn-secondary" href="#configuration">Blueprint <ArrowIcon direction="down" /></a>
            </div>
            <p class="hero-meta">Open source. Bring your own models. Make it yours.</p>
          </div>
          <figure class="hero-art" aria-hidden="true">
            <div class="hero-halo"></div>
            <picture>
              <source media="(max-width: 640px)" srcset="/hero-mobile-320.webp 320w, /hero-mobile-640.webp 640w" sizes="220px" width="640" height="640" />
              <source type="image/webp" srcset="/hero-640.webp 640w, /hero-960.webp 960w, /hero-1440.webp 1440w" sizes="(max-width: 640px) 220px, (max-width: 1050px) 50vw, 540px" />
              <img
                src="/hero-1440.webp"
                srcset="/hero-640.webp 640w, /hero-960.webp 960w, /hero-1440.webp 1440w"
                sizes="(max-width: 640px) 220px, (max-width: 1050px) 50vw, 540px"
                width="1254"
                height="1254"
                alt=""
                fetchpriority="high"
              />
            </picture>
            <figcaption class="visually-hidden">Decorative brand illustration, not a product screenshot.</figcaption>
          </figure>
        </div>
        <div class="wrap hero-footnote"><span>01 / YOUR WORK, YOUR WAY</span><a href="#configuration">Open the blueprint <ArrowIcon direction="down" /></a></div>
      </section>

      <section class="capability-strip" aria-label="Core capabilities">
        <div class="wrap"><span>Built around your choices</span><ul><li>Local &amp; cloud models</li><li>Persistent conversations</li><li>Skills &amp; MCP</li><li>Optional memory</li></ul></div>
      </section>

      <section class="configuration" id="configuration" aria-labelledby="configuration-heading">
        <div class="wrap configuration-intro">
          <span class="section-label">The configuration</span>
          <h2 id="configuration-heading">One JSON file.<br /><em>Your agent’s blueprint.</em></h2>
          <p>
            Models, context, memory, tools. One readable declaration.
            Version it, review it, make it yours.
          </p>
        </div>
        <div class="wrap blueprint-layout">
          <figure class="config-blueprint">
            <figcaption>
              <span aria-hidden="true">&#123; &#125;</span>
              <strong>mono-agent.config.json</strong>
              <span>Example</span>
            </figcaption>
            <div class="blueprint-code"><pre><code id="config-blueprint-json">{CONFIG_EXAMPLE}</code></pre></div>
            <p>
              Identity and skills stay in referenced files. Secrets stay outside the blueprint.
            </p>
          </figure>


        </div>
        <section class="wrap building-blocks" aria-labelledby="blocks-heading">
          <div class="blocks-heading"><div><h3 id="blocks-heading">Choose your<br /><em>building blocks.</em></h3></div><p>Start with a model and a point of view. Add only what your work needs.</p></div>
          <div class="blocks-toolbar"><span>One agent. Many possibilities.</span><button class="motion-toggle" type="button" aria-pressed="false" hidden>Pause motion</button></div>
          <div class="block-summary" data-active-card="0">
            <ol class="block-chapters">
              <li class="block-chapter" data-card-index="0" data-active="true">
                <h4>Foundation</h4>
                <p>Set the role, model routes, and reusable instructions that shape each turn.</p>
                <figure class="block-diagram diagram-foundation" aria-hidden="true">
                  <svg viewBox="0 0 160 110" aria-hidden="true" focusable="false">
                    <path class="diagram-line" d="M28 22h82l22 18v48H28z" />
                    <path class="diagram-line" d="M110 22v18h22M40 50h58M40 63h77M40 76h48" />
                    <path class="diagram-accent" d="M18 31v67h104" />
                    <circle class="diagram-node" cx="18" cy="31" r="4" />
                    <circle class="diagram-node" cx="122" cy="98" r="4" />
                  </svg>
                </figure>
                <ul class="block-links">
                  <li><a href={`${DOCS_URL}context/`}>Identity &amp; context <ArrowIcon /></a></li>
                  <li><a href={`${DOCS_URL}runtime/`}>Models &amp; routing <ArrowIcon /></a></li>
                  <li><a href={`${DOCS_URL}context/skills/`}>Skills <ArrowIcon /></a></li>
                </ul>
              </li>
              <li class="block-chapter" data-card-index="1" data-active="false">
                <h4>Context &amp; connections</h4>
                <p>Connect tools, memory, and adapters without collapsing their boundaries.</p>
                <figure class="block-diagram diagram-connections" aria-hidden="true">
                  <svg viewBox="0 0 160 110" aria-hidden="true" focusable="false">
                    <path class="diagram-line" d="M80 55 31 28m49 27 49-27M80 55 31 84m49-29 49 29" />
                    <circle class="diagram-node" cx="80" cy="55" r="14" />
                    <circle class="diagram-accent" cx="31" cy="28" r="9" />
                    <circle class="diagram-accent" cx="129" cy="28" r="9" />
                    <circle class="diagram-accent" cx="31" cy="84" r="9" />
                    <circle class="diagram-accent" cx="129" cy="84" r="9" />
                  </svg>
                </figure>
                <ul class="block-links">
                  <li><a href={`${DOCS_URL}tools/mcp/`}>Tools &amp; MCP <ArrowIcon /></a></li>
                  <li><a href={`${DOCS_URL}memory/`}>Memory <ArrowIcon /></a></li>
                  <li><a href={`${DOCS_URL}programmatic/composition/`}>Packages &amp; adapters <ArrowIcon /></a></li>
                </ul>
              </li>
              <li class="block-chapter" data-card-index="2" data-active="false">
                <h4>Delegated work</h4>
                <p>Hand focused work to subagents and bounded background jobs.</p>
                <figure class="block-diagram diagram-delegated" aria-hidden="true">
                  <svg viewBox="0 0 160 110" aria-hidden="true" focusable="false">
                    <path class="diagram-line" d="M27 55h30m0 0c20 0 15-30 35-30h39M57 55h74m-74 0c20 0 15 30 35 30h39" />
                    <circle class="diagram-node" cx="27" cy="55" r="8" />
                    <path class="diagram-accent" d="m124 19 7 6-7 6m0 18 7 6-7 6m0 18 7 6-7 6" />
                  </svg>
                </figure>
                <ul class="block-links">
                  <li><a href={`${DOCS_URL}config/blueprint/`}>Subagents <ArrowIcon /></a></li>
                  <li><a href={`${DOCS_URL}tools/background-process-jobs/`}>Background jobs <ArrowIcon /></a></li>
                  <li><a href={`${DOCS_URL}tools/sandbox/`}>Sandbox &amp; policy <ArrowIcon /></a></li>
                </ul>
              </li>
              <li class="block-chapter" data-card-index="3" data-active="false">
                <h4>Continuity</h4>
                <p>Carry work across channels and schedules, with evidence to inspect.</p>
                <figure class="block-diagram diagram-continuity" aria-hidden="true">
                  <svg viewBox="0 0 160 110" aria-hidden="true" focusable="false">
                    <path class="diagram-line" d="M32 74c6 20 26 29 48 29 31 0 53-21 53-48S111 8 80 8 27 28 27 55" />
                    <path class="diagram-accent" d="m17 48 10 10 10-10M48 55h64" />
                    <circle class="diagram-node" cx="48" cy="55" r="6" />
                    <circle class="diagram-node" cx="80" cy="55" r="6" />
                    <circle class="diagram-node" cx="112" cy="55" r="6" />
                  </svg>
                </figure>
                <ul class="block-links">
                  <li><a href={`${DOCS_URL}channels/`}>Channels <ArrowIcon /></a></li>
                  <li><a href={`${DOCS_URL}channels/cron/`}>Schedules <ArrowIcon /></a></li>
                  <li><a href={`${DOCS_URL}observability/`}>Run evidence <ArrowIcon /></a></li>
                </ul>
              </li>
            </ol>
          </div><p class="blocks-note">Compose what you need; not every capability is on by default. Persistent/background subagents and console projects/tags require the current source build. <a href={RELEASE_STATUS_URL}>Check release availability <ArrowIcon /></a></p></section>
      </section>

      <section class="console-section section" id="console" aria-labelledby="console-heading">
        <div class="wrap">
          <div class="console-intro"><div><span class="section-label">The workspace</span><h2 id="console-heading">Made for you.<br /><em>Open to your agent.</em></h2></div><p>One considered interface for conversations, context, and the models behind your work.</p></div>
          <figure class="console-shot"><div class="console-frame"><a href="/console-desktop.webp" aria-label="Open full resolution desktop console screenshot"><img src="/console-desktop.webp" width="1920" height="1350" loading="lazy" alt="Desktop Mono Agent console showing a conversation, sidebar, model-change marker, and message composer." /></a></div><figcaption>Actual desktop console · synthetic example data and connection state · current source build. <span class="console-pan-hint">Tap for details · </span><a href="/console-desktop.webp">Open full resolution <ArrowIcon /></a> · <a href={RELEASE_STATUS_URL}>Release availability <ArrowIcon /></a></figcaption></figure>
          <div class="console-benefits" id="why">
            <article><span>01 / CONTINUITY</span><h3>Change models. Keep the thread.</h3><p>Choose a supported model for your next reply without starting over. Your conversation stays with you.</p></article>
            <article><span>02 / SHARED CONTROLS</span><h3>You click. Your agent calls a tool.</h3><p>Create projects, organize tags, and find conversations through the interface—or let your agent use the corresponding tools.</p></article>
            <article><span>03 / YOUR ARCHITECTURE</span><h3>A workspace. And a framework.</h3><p>Use the complete host or embed the configured responder in your own product. Same building blocks, your composition.</p></article>
          </div>
          <a class="text-link" href={`${DOCS_URL}observability/web-console/`}>Explore the console <ArrowIcon /></a>
        </div>
      </section>

      <section class="section comparison" id="comparison" aria-labelledby="comparison-heading">
        <div class="wrap">
          <span class="section-label">Find your fit</span>
          <h2 id="comparison-heading">Different harnesses.<br /><em>Different starting points.</em></h2>
          <p class="section-intro">Hermes and OpenClaw are close alternatives; coding harnesses start from a different workflow. Compare the focus, not just the feature list.</p>
          <dl class="harness-list">
            <div class="harness-row harness-mono">
              <dt><a href={CONFIG_URL}>Mono Agent <ArrowIcon /></a><span>Config-first workspace &amp; framework</span></dt>
              <dd>Compose models, tools, optional memory, and channels in one blueprint. Run the workspace or build on its packages.</dd>
            </div>
            <div class="harness-row">
              <dt><a href="https://hermes-agent.nousresearch.com/docs/">Hermes Agent <ArrowIcon /></a><span>Learning-oriented personal agent</span></dt>
              <dd>Reuse and develop skills across sessions, retain memory, connect messaging channels, and schedule recurring work.</dd>
            </div>
            <div class="harness-row">
              <dt><a href="https://docs.openclaw.ai/">OpenClaw <ArrowIcon /></a><span>Self-hosted messaging gateway</span></dt>
              <dd>Connect chat apps to agents through one gateway, with sessions, memory, multi-agent routing, and a browser control UI.</dd>
            </div>
          </dl>
          <details class="comparison-more">
            <summary>Coding harnesses <span>Codex · Claude Code · OpenCode</span></summary>
            <dl class="harness-list">
            <div class="harness-row">
              <dt><a href="https://developers.openai.com/codex/cli/">Codex CLI <ArrowIcon /></a><span>Terminal coding &amp; automation</span></dt>
              <dd>Inspect, edit, run, and review a repository. Use skills and MCP, or script repeatable work with <code>codex exec</code>.</dd>
            </div>
            <div class="harness-row">
              <dt><a href="https://code.claude.com/docs/en/overview">Claude Code <ArrowIcon /></a><span>Coding across terminal, IDE &amp; web</span></dt>
              <dd>Extend coding workflows with project instructions, skills, hooks, and MCP. Build custom agents with the Agent SDK.</dd>
            </div>
            <div class="harness-row">
              <dt><a href="https://opencode.ai/docs/">OpenCode <ArrowIcon /></a><span>Provider-flexible coding</span></dt>
              <dd>Choose model providers and move between Plan and Build modes in an open-source terminal, desktop, or IDE workflow.</dd>
            </div>
          </dl>
          </details>
          <p class="comparison-note">A snapshot of documented focus, not a feature or performance ranking. Each name links to its official docs. Checked 20 September 2026.</p>
          <p class="comparison-choice">Choose Mono Agent when you want to shape the whole setup—<strong>models, context, memory, tools, and channels</strong>—and keep it in a versioned blueprint.</p>
        </div>
      </section>

      <section class="section" id="start" aria-labelledby="start-heading">
        <div class="wrap">
          <span class="section-label">Get started</span>
          <h2 id="start-heading">From empty folder to working agent</h2>
          <p class="section-intro">
            A real workspace, not another hosted account. You’ll need Node.js 24.15+
            and access to a model. Guided setup is not instant: it checks your routes
            with real model calls, which can take several minutes and count as usage.
          </p>
          <ol class="steps">
            <li>
              <h3>Install the CLI</h3>
              <p>Requires Node.js 24.15.0 or newer. No pnpm needed.</p>
              <pre><code id="install-command">npm i -g create-mono-agent</code></pre>
              <button class="copy-command" type="button" hidden>Copy command <ArrowIcon /></button><p class="copy-status" role="status" aria-live="polite"></p>
            </li>
            <li>
              <h3>Create the agent folder</h3>
              <p>
                Bare <code>init</code> on a terminal is the guided wizard: it
                names the agent, writes its role, and proves each model route.
                Any flag scaffolds the files only.
              </p>
              <pre><code>mkdir my-agent
cd my-agent
mono-agent init</code></pre>
            </li>
            <li>
              <h3>Start it, then open the workspace</h3>
              <p>
                Validate and start the agent, then run the browser console in
                its own terminal and open the URL it prints.
              </p>
              <pre><code>mono-agent validate
mono-agent start
mono-agent web run --loopback</code></pre>
            </li>
          </ol>
          <div class="note">
            <p>
              <strong>Published vs. source.</strong> The docs describe the
              current source; the published npm release can lag behind it. The
              <a href={RELEASE_STATUS_URL}>release status page</a> lists exactly
              what is in the release and how to run a source build instead.
            </p>
          </div>
        </div>
      </section>

      <section class="section" id="faq" aria-labelledby="faq-heading">
        <div class="wrap">
          <span class="section-label">FAQ</span>
          <h2 id="faq-heading">Short answers, honestly</h2>
          <div class="faq">
            <details>
              <summary>Is everything really in one JSON file?</summary>
              <div class="faq-answer">
                The blueprint brings runtime, context references, memory, tools,
                and channels together. Identity, skills, MCP definitions, secrets,
                provider auth, and framework-managed state stay in their own files
                or stores. You still need the referenced files, provider auth,
                and any channel or memory services the blueprint selects. Run
                <code>mono-agent validate</code> to check the shape, finish any
                reported setup, and restart after edits.
              </div>
            </details>
            <details>
              <summary>What does “local-first” actually mean here?</summary>
              <div class="faq-answer">
                Your agent files and run artifacts are stored on your machine
                by default. The models, tools, and channels you configure may
                send the context they need to their own services, so read what
                each one transmits before you enable it. Preferring a model on
                your own hardware keeps even inference local.
              </div>
            </details>
            <details>
              <summary>What can I inspect after a run?</summary>
              <div class="faq-answer">
                Local JSONL events and a run summary record model changes, tool
                activity, timing, and usage that reached the recorder. These are
                bounded, best-effort filesystem records rather than a transactional
                audit log, so a crash can lose an unsaved tail. Use them to review
                what happened, not as proof that every in-flight event persisted.
              </div>
            </details>
            <details>
              <summary>Which models can I use?</summary>
              <div class="faq-answer">
                Supported <code>&lt;provider&gt;:&lt;model&gt;</code> routes include
                subscription and API providers such as OpenAI Codex and
                Anthropic, plus fully local providers like Ollama or LM Studio.
                Ordered fallbacks can try another route, and results and traces
                report when the selected route changes.
              </div>
            </details>
            <details>
              <summary>Is the web console safe to expose?</summary>
              <div class="faq-answer">
                Treat it as single-owner with no application login: anyone who
                can reach it can operate your agents. Keep it on loopback
                unless you have a reason not to, and read the console security
                docs first.
              </div>
            </details>
            <details>
              <summary>What does it cost?</summary>
              <div class="faq-answer">
                mono-agent itself is free, open-source software under GPL-3.0.
                Cloud usage follows your provider’s subscription or API pricing,
                including setup calls. Local models use your own hardware.
              </div>
            </details>
            <details>
              <summary>Where is the full documentation?</summary>
              <div class="faq-answer">
                The complete guides, configuration reference, and security model
                live on the documentation site — start there when the config
                file gets ambitious.
              </div>
            </details>
          </div>
        </div>
      </section>

