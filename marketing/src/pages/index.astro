---
// mono-agent marketing site — single static page for https://mono-agent.dev/.
//
// Copy rules for this file: every claim must already be true of the published
// baseline or be explicitly framed as configuration. Never advertise
// source-only capabilities (console projects/tags, durable subagents, usage
// meters — see docs/reference/release-status.md), never promise setup speed,
// security, or availability, and never present the decorative brand artwork
// as a product screenshot.
const SITE_URL = "https://mono-agent.dev";
const GITHUB_URL = "https://github.com/robertsreberski/mono-agent";
const DOCS_URL = "https://mono-agent-docs.vercel.app/";
const RELEASE_STATUS_URL = `${DOCS_URL}reference/release-status/`;
const CONFIG_URL = `${DOCS_URL}config/`;
const COMPOSITION_URL = `${DOCS_URL}programmatic/composition/`;
const MEMORY_URL = `${DOCS_URL}memory/`;
const FALLBACK_URL = `${DOCS_URL}runtime/fallback/`;
const ARTIFACTS_URL = `${DOCS_URL}observability/artifacts-and-traces/`;
const TOOLS_URL = `${DOCS_URL}tools/`;

const CONFIG_EXAMPLE = `{
  "runtime": {
    "model": "openai-codex:gpt-5.6-terra",
    "workspace": "."
  },
  "context": {
    "identityPath": "./IDENTITY.md",
    "skillsRoot": "./skills",
    "selectedSkills": ["code-review"]
  },
  "memory": {
    "mode": "lite",
    "writeMode": "append-host-summary"
  },
  "tools": {
    "allowedTools": ["Read", "Grep", "WebSearch"],
    "mcpConfigPath": "./mcp.json"
  },
  "telegram": {
    "enabled": true,
    "allowedChatIds": ["YOUR_CHAT_ID"]
  }
}`;

const TITLE = "mono-agent — Local-first AI workspace for coding and research";
const DESCRIPTION =
  "mono-agent is a local-first, config-first AI workspace for coding, research, and automation. One mono-agent.config.json defines your agent — models, tools, skills, memory, and channels. Open source (GPL-3.0).";
const OG_IMAGE = `${SITE_URL}/og-1200x630.jpg`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}/#website`,
      url: `${SITE_URL}/`,
      name: "mono-agent",
      description: DESCRIPTION,
    },
    {
      "@type": "Organization",
      "@id": `${SITE_URL}/#organization`,
      name: "mono-agent",
      url: `${SITE_URL}/`,
      logo: OG_IMAGE,
      sameAs: [GITHUB_URL],
    },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    <link rel="canonical" href={`${SITE_URL}/`} />
    <meta name="theme-color" content="#101311" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/styles.css" />
    <script is:inline type="module" src="/interactions.js"></script>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="mono-agent" />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:url" content={`${SITE_URL}/`} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="mono-agent social card: the brand name and “Local-first AI workspace for coding and research” beside the stacked-slab artwork."
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={TITLE} />
    <meta name="twitter:description" content={DESCRIPTION} />
    <meta name="twitter:image" content={OG_IMAGE} />
    <meta
      name="twitter:image:alt"
      content="mono-agent social card: the brand name and “Local-first AI workspace for coding and research” beside the stacked-slab artwork."
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="#top" aria-label="mono-agent — back to top">
          <img src="/favicon.svg" alt="" width="30" height="30" aria-hidden="true" />
          <span>mono-agent</span>
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation" hidden><span>Menu</span><svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M3 7h14M3 13h14" /></svg></button>
        <nav class="site-nav" id="site-navigation" aria-label="Sections">
          <ul>
            <li><a href="#configuration">Blueprint</a></li>
            <li><a href="#console">Console</a></li>
            <li><a href="#use-cases">Workflows</a></li>
            <li><a href={DOCS_URL}>Docs ↗</a></li>
            <li class="mobile-github"><a href={GITHUB_URL}>Get the code ↗</a></li>
          </ul>
        </nav>
        <div class="header-cta">

          <a class="btn btn-primary btn-small" href={GITHUB_URL}>GitHub</a>
        </div>
      </div>
    </header>

    <main id="main">
      <section class="hero" id="top" aria-labelledby="hero-heading">
        <div class="wrap hero-grid">
          <div class="hero-copy">
            <span class="eyebrow">Independent by design / Config-first AI</span>
            <h1 id="hero-heading">Your agents. <br />Your models. <br /><em>Your workspace.</em></h1>
            <p class="lede">
              Compose models, tools, memory, and channels in
              <code>mono-agent.config.json</code>. Run the workspace—or build
              on the packages underneath.
            </p>
            <div class="hero-actions">
              <a class="btn btn-primary" href={GITHUB_URL}>Get the code on GitHub <span aria-hidden="true">↗</span></a>
              <a class="btn btn-secondary" href="#configuration">Explore the blueprint <span aria-hidden="true">↓</span></a>
            </div>
            <p class="hero-meta">Open source. Bring your own models. Make it yours.</p>
          </div>
          <figure class="hero-art" aria-hidden="true">
            <div class="hero-halo"></div>
            <picture>
              <source type="image/webp" srcset="/hero-640.webp 640w, /hero-960.webp 960w, /hero-1440.webp 1440w" sizes="(max-width: 959px) 100vw, (max-width: 1250px) 80vw, 1000px" />
              <img
                src="/hero-1440.jpg"
                srcset="/hero-640.jpg 640w, /hero-960.jpg 960w, /hero-1440.jpg 1440w"
                sizes="(max-width: 959px) 100vw, (max-width: 1250px) 80vw, 1000px"
                width="1536"
                height="1024"
                alt=""
                fetchpriority="high"
              />
            </picture>
            <figcaption class="visually-hidden">Decorative brand illustration, not a product screenshot.</figcaption>
          </figure>
        </div>
        <div class="wrap hero-footnote"><span>01 / YOUR WORK, YOUR WAY</span><a href="#configuration">Open the blueprint <span aria-hidden="true">↓</span></a></div>
      </section>

      <section class="capability-strip" aria-label="Core capabilities">
        <div class="wrap"><span>Built around your choices</span><ul><li>Local &amp; cloud models</li><li>Persistent conversations</li><li>Skills &amp; MCP</li><li>Optional memory</li></ul></div>
      </section>

      <section class="configuration" id="configuration" aria-labelledby="configuration-heading">
        <div class="wrap configuration-intro">
          <span class="section-label">The configuration</span>
          <h2 id="configuration-heading">One JSON file.<br /><em>Your agent’s blueprint.</em></h2>
          <p>
            Models, context, memory, tools. One readable declaration.
            Version it, review it, make it yours.
          </p>
        </div>
        <div class="wrap blueprint-layout">
          <figure class="config-blueprint">
            <figcaption>
              <span aria-hidden="true">&#123; &#125;</span>
              <strong>mono-agent.config.json</strong>
              <span>Illustrative, valid JSON</span>
            </figcaption>
            <details class="blueprint-code"><summary>Read the configuration <span aria-hidden="true">+</span></summary><pre><code id="config-blueprint-json">{CONFIG_EXAMPLE}</code></pre></details>
            <p>
              Identity and skills stay in referenced files. Secrets stay outside the blueprint.
            </p>
          </figure>

          <div class="blueprint-callouts blueprint-callouts-left">
            <article>
              <span class="config-key">runtime</span>
              <h3>Choose the route</h3>
              <p>Set the primary model, workspace, and ordered fallbacks. Route changes are reported rather than hidden.</p>
              <a href={FALLBACK_URL}>Read routing behavior <span aria-hidden="true">↗</span></a>
            </article>
            <article>
              <span class="config-key">context</span>
              <h3>Bring the point of view</h3>
              <p>Reference an identity and select versioned skills without folding their contents into the JSON file.</p>
              <a href={`${DOCS_URL}context/`}>See context assembly <span aria-hidden="true">↗</span></a>
            </article>
            <article>
              <span class="config-key">memory</span>
              <h3>Pick the right weight</h3>
              <p>Omit memory, start with local Lite, add embeddings with Journal, or configure BuJo’s model-assisted tier.</p>
              <a href={MEMORY_URL}>Compare memory tiers <span aria-hidden="true">↗</span></a>
            </article>
          </div>

        </div>
      </section>

      <section class="console-section section" id="console" aria-labelledby="console-heading">
        <div class="wrap">
          <div class="console-intro"><div><span class="section-label">The workspace</span><h2 id="console-heading">Made for you.<br /><em>Open to your agent.</em></h2></div><p>One considered interface for conversations, context, and the models behind your work.</p></div>
          <figure class="console-shot"><a href="/console-desktop.webp" aria-label="Open full console screenshot"><picture><source media="(max-width: 640px)" srcset="/console-mobile.webp" /><img src="/console-desktop.webp" width="1280" height="560" loading="lazy" alt="Mono Agent console with a project and two example conversations." /></picture></a><figcaption>Actual console UI · synthetic example data · current source build. <a href={RELEASE_STATUS_URL}>Release availability ↗</a></figcaption></figure>
          <div class="console-benefits" id="why">
            <article><span>01 / CONTINUITY</span><h3>Change models. Keep the thread.</h3><p>Choose a supported model for your next reply without starting over. Your conversation stays with you.</p></article>
            <article><span>02 / SHARED CONTROLS</span><h3>You click. Your agent calls a tool.</h3><p>Create projects, organize tags, and find conversations through the interface—or let your agent use the corresponding tools.</p></article>
            <article><span>03 / YOUR ARCHITECTURE</span><h3>A workspace. And a framework.</h3><p>Use the complete host or embed the configured responder in your own product. Same building blocks, your composition.</p></article>
          </div>
          <a class="text-link" href={`${DOCS_URL}observability/web-console/`}>Explore the console <span aria-hidden="true">↗</span></a>
        </div>
      </section>

      <section class="section" id="use-cases" aria-labelledby="use-cases-heading">
        <div class="wrap">
          <span class="section-label">Use cases</span>
          <h2 id="use-cases-heading">Less switching.<br /><em>More doing.</em></h2>
          <p class="section-intro">For the code you need to ship, the question you need to answer,
            and the routine you would rather not repeat.</p>
          <div class="workflow-explorer" data-workflow-explorer>
            <nav class="workflow-tabs" aria-label="Choose a workflow">
              <a id="tab-build" href="#workflow-build" data-workflow="build"><span>01</span> Build <span class="tab-arrow" aria-hidden="true">↗</span></a>
              <a id="tab-research" href="#workflow-research" data-workflow="research"><span>02</span> Research <span class="tab-arrow" aria-hidden="true">↗</span></a>
              <a id="tab-automate" href="#workflow-automate" data-workflow="automate"><span>03</span> Automate <span class="tab-arrow" aria-hidden="true">↗</span></a>
            </nav>
            <div class="workflow-panels">
              <article class="workflow-panel" id="workflow-build" data-panel="build">
                <div class="workflow-content"><span class="section-label">Your codebase. A second perspective.</span><h3>From stuck to shipped.</h3><p>Trace a bug, review a change, or work through a failing test. Keep the context in one persistent conversation.</p>
                  <div class="example-prompt"><span>Try asking</span><p>“Find why this test fails. Explain the cause, then propose a fix.”</p></div>
                  <a class="workflow-link" href={`${DOCS_URL}getting-started/quickstart/`}>Start with a project <span aria-hidden="true">↗</span></a>
                </div>
                <figure class="workflow-art">
                  <span class="scene-label">FIELD NOTES / 01</span>
                  <svg viewBox="0 0 520 400" fill="none" aria-hidden="true"><path class="scene-wire" d="M80 180H160Q190 180 190 220V250H310Q340 250 340 210V170H450"/><rect class="scene-sheet" x="55" y="95" width="160" height="140" rx="12" transform="rotate(-8 135 165)"/><path class="scene-accent" d="M105 140L82 163L105 186M161 140L184 163L161 186M145 135L122 190"/><rect class="scene-sheet" x="300" y="165" width="165" height="145" rx="12" transform="rotate(8 380 235)"/><path class="scene-accent" d="M330 223L346 239L376 205"/><path class="scene-line" d="M393 216H431M393 233H419M329 263H426"/><circle class="scene-core" cx="260" cy="165" r="36"/><path class="scene-accent" d="M245 165H275M260 150V180"/></svg>
                  <figcaption>Codebase → investigate → proposed change<small>Illustrative workflow — not a live agent run</small></figcaption>
                </figure>
              </article>
              <article class="workflow-panel" id="workflow-research" data-panel="research">
                <div class="workflow-content"><span class="section-label">Your sources. A clearer picture.</span><h3>Connect the dots.</h3><p>Bring the documents, notes, and questions. Compare ideas, spot disagreements, and shape the material into a useful draft.</p>
                  <div class="example-prompt"><span>Try asking</span><p>“Compare these reports. Where do they disagree, and what is missing?”</p></div>
                  <a class="workflow-link" href={`${DOCS_URL}memory/`}>Explore optional memory <span aria-hidden="true">↗</span></a>
                </div>
                <figure class="workflow-art">
                  <span class="scene-label">FIELD NOTES / 02</span>
                  <svg viewBox="0 0 520 400" fill="none" aria-hidden="true"><path class="scene-wire" d="M100 210C180 210 180 125 260 125S335 260 420 260"/><rect class="scene-sheet" x="80" y="90" width="155" height="190" rx="9" transform="rotate(-12 155 185)"/><path class="scene-line" d="M105 130H196M105 155H180M105 180H196M105 205H158"/><rect class="scene-sheet" x="278" y="116" width="155" height="190" rx="9" transform="rotate(9 355 215)"/><path class="scene-line" d="M305 156H403M305 184H380M305 212H397M305 240H370"/><circle class="scene-core" cx="258" cy="195" r="49"/><path class="scene-accent" d="M236 192L251 207L280 178"/><path class="scene-accent" d="M111 232H180M307 269H387"/></svg>
                  <figcaption>Source material → compare → working draft<small>Illustrative workflow — not a live agent run</small></figcaption>
                </figure>
              </article>
              <article class="workflow-panel" id="workflow-automate" data-panel="automate">
                <div class="workflow-content"><span class="section-label">Your routine. Less repetition.</span><h3>Find your rhythm.</h3><p>Connect a schedule, a channel, and the tools you choose. Make room for the work that needs your attention.</p>
                  <div class="example-prompt"><span>Example workflow</span><p>A scheduled morning digest from the sources and tools you configure.</p></div>
                  <a class="workflow-link" href={`${DOCS_URL}channels/cron/`}>Explore scheduled work <span aria-hidden="true">↗</span></a>
                </div>
                <figure class="workflow-art">
                  <span class="scene-label">FIELD NOTES / 03</span>
                  <svg viewBox="0 0 520 400" fill="none" aria-hidden="true"><circle class="scene-orbit" cx="260" cy="200" r="126"/><circle class="scene-orbit" cx="260" cy="200" r="85"/><path class="scene-wire" d="M134 200H386M260 74V326"/><rect class="scene-sheet" x="217" y="155" width="86" height="90" rx="20"/><path class="scene-accent" d="M265 171L245 202H272L252 230"/><circle class="scene-core" cx="260" cy="74" r="25"/><path class="scene-accent" d="M249 74L257 82L271 66"/><circle class="scene-core" cx="386" cy="200" r="25"/><path class="scene-accent" d="M375 200H397M386 189V211"/><circle class="scene-core" cx="134" cy="200" r="25"/><path class="scene-accent" d="M123 195H145M123 205H139"/><circle class="scene-core" cx="260" cy="326" r="25"/><path class="scene-accent" d="M260 312V326L270 332"/></svg>
                  <figcaption>Schedule → configured agent → digest<small>Illustrative workflow — not a live agent run</small></figcaption>
                </figure>
              </article>
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="start" aria-labelledby="start-heading">
        <div class="wrap">
          <span class="section-label">Get started</span>
          <h2 id="start-heading">From empty folder to working agent</h2>
          <p class="section-intro">
            A real workspace, not another hosted account. You’ll need Node.js 24.15+
            and access to a model. Guided setup is not instant: it checks your routes
            with real model calls, which can take several minutes and count as usage.
          </p>
          <ol class="steps">
            <li>
              <h3>Install the CLI</h3>
              <p>Requires Node.js 24.15.0 or newer. No pnpm needed.</p>
              <pre><code id="install-command">npm i -g create-mono-agent</code></pre>
              <button class="copy-command" type="button" hidden>Copy install command <span aria-hidden="true">↗</span></button><p class="copy-status" role="status" aria-live="polite"></p>
            </li>
            <li>
              <h3>Create the agent folder</h3>
              <p>
                Bare <code>init</code> on a terminal is the guided wizard: it
                names the agent, writes its role, and proves each model route.
                Any flag scaffolds the files only.
              </p>
              <pre><code>mkdir my-agent
cd my-agent
mono-agent init</code></pre>
            </li>
            <li>
              <h3>Start it, then open the workspace</h3>
              <p>
                Validate and start the agent, then run the browser console in
                its own terminal and open the URL it prints.
              </p>
              <pre><code>mono-agent validate
mono-agent start
mono-agent web run --loopback</code></pre>
            </li>
          </ol>
          <div class="note">
            <p>
              <strong>Published vs. source.</strong> The docs describe the
              current source; the published npm release can lag behind it. The
              <a href={RELEASE_STATUS_URL}>release status page</a> lists exactly
              what is in the release and how to run a source build instead.
            </p>
          </div>
        </div>
      </section>

      <section class="section" id="faq" aria-labelledby="faq-heading">
        <div class="wrap">
          <span class="section-label">FAQ</span>
          <h2 id="faq-heading">Short answers, honestly</h2>
          <div class="faq">
            <details>
              <summary>Is everything really in one JSON file?</summary>
              <div class="faq-answer">
                The blueprint brings runtime, context references, memory, tools,
                and channels together. Identity, skills, MCP definitions, secrets,
                provider auth, and framework-managed state stay in their own files
                or stores. You still need the referenced files, provider auth,
                and any channel or memory services the blueprint selects. Run
                <code>mono-agent validate</code> to check the shape, finish any
                reported setup, and restart after edits.
              </div>
            </details>
            <details>
              <summary>What does “local-first” actually mean here?</summary>
              <div class="faq-answer">
                Your agent files and run artifacts are stored on your machine
                by default. The models, tools, and channels you configure may
                send the context they need to their own services, so read what
                each one transmits before you enable it. Preferring a model on
                your own hardware keeps even inference local.
              </div>
            </details>
            <details>
              <summary>What can I inspect after a run?</summary>
              <div class="faq-answer">
                Local JSONL events and a run summary record model changes, tool
                activity, timing, and usage that reached the recorder. These are
                bounded, best-effort filesystem records rather than a transactional
                audit log, so a crash can lose an unsaved tail. Use them to review
                what happened, not as proof that every in-flight event persisted.
              </div>
            </details>
            <details>
              <summary>Which models can I use?</summary>
              <div class="faq-answer">
                Supported <code>&lt;provider&gt;:&lt;model&gt;</code> routes include
                subscription and API providers such as OpenAI Codex and
                Anthropic, plus fully local providers like Ollama or LM Studio.
                Ordered fallbacks can try another route, and results and traces
                report when the selected route changes.
              </div>
            </details>
            <details>
              <summary>Is the web console safe to expose?</summary>
              <div class="faq-answer">
                Treat it as single-owner with no application login: anyone who
                can reach it can operate your agents. Keep it on loopback
                unless you have a reason not to, and read the console security
                docs first.
              </div>
            </details>
            <details>
              <summary>What does it cost?</summary>
              <div class="faq-answer">
                mono-agent itself is free, open-source software under GPL-3.0.
                Cloud usage follows your provider’s subscription or API pricing,
                including setup calls. Local models use your own hardware.
              </div>
            </details>
            <details>
              <summary>Where is the full documentation?</summary>
              <div class="faq-answer">
                The complete guides, configuration reference, and security model
                live on the documentation site — start there when the config
                file gets ambitious.
              </div>
            </details>
          </div>
        </div>
      </section>

    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>mono-agent — open source under GPL-3.0-only.</span>
        <nav aria-label="Project links">
          <ul>
            <li><a href={GITHUB_URL}>GitHub</a></li>
            <li><a href={DOCS_URL}>Documentation</a></li>
            <li><a href={RELEASE_STATUS_URL}>Release status</a></li>
          </ul>
        </nav>
      </div>
    </footer>
  </body>
</html>
