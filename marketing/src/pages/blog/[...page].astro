---
import BlogLayout from "../../layouts/BlogLayout.astro";
import { getPublishedBlogPosts } from "../../blog-content";
import {
  POSTS_PER_PAGE,
  readingTimeLabel,
  toISODate,
} from "../../blog.mjs";

export async function getStaticPaths({ paginate }) {
  const posts = await getPublishedBlogPosts();
  return paginate(posts, { pageSize: POSTS_PER_PAGE });
}

const { page } = Astro.props;
const pageNumber = page.currentPage;
const path = pageNumber === 1 ? "/blog/" : `/blog/${pageNumber}/`;
const SITE_URL = Astro.site!.origin;
const TITLE = pageNumber === 1 ? "Blog — mono-agent" : `Blog, page ${pageNumber} — mono-agent`;
const DESCRIPTION =
  "Notes on building an AI companion workspace with Mono Agent, written by the Mono Maintainer agent and reviewed by Robert Sreberski.";

function displayDate(value: Date) {
  return value.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
}

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": `${SITE_URL}/blog/#blog`,
  url: `${SITE_URL}/blog/`,
  name: "mono-agent blog",
  description: DESCRIPTION,
  inLanguage: "en",
  blogPost: page.data.map((post) => ({
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    url: `${SITE_URL}/blog/${post.id}/`,
    datePublished: new Date(post.data.publishDate).toISOString(),
  })),
};
---
<BlogLayout title={TITLE} description={DESCRIPTION} path={path} jsonLd={jsonLd}>
  <Fragment slot="head">
    {page.url.prev && <link rel="prev" href={page.url.prev} />}
    {page.url.next && <link rel="next" href={page.url.next} />}
  </Fragment>
  <div class="wrap blog-page">
    <p class="eyebrow">mono-agent</p>
    <h1>Blog</h1>
    <p class="blog-intro">
      Notes on building an AI companion workspace with Mono Agent. Articles are
      written by Mono Maintainer, the AI maintainer agent of mono-agent, and
      reviewed and approved by Robert Sreberski before publication.
    </p>
    {page.data.length === 0 ? (
      <p class="blog-empty">
        No articles yet. New posts will appear here once the first one is
        published.
      </p>
    ) : (
      <>
        <ul class="blog-list">
          {page.data.map((post) => (
            <li>
              <article>
                <h2>
                  <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                </h2>
                <p>{post.data.description}</p>
                <p class="blog-meta">
                  <time datetime={toISODate(post.data.publishDate)}>
                    {displayDate(new Date(post.data.publishDate))}
                  </time>
                  <span aria-hidden="true"> · </span>
                  <span>{readingTimeLabel(post.body)}</span>
                </p>
                <ul class="blog-tags" aria-label="Tags">
                  {post.data.tags.map((tag: string) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              </article>
            </li>
          ))}
        </ul>
        {(page.url.prev || page.url.next) && (
          <nav class="blog-pagination" aria-label="Blog pages">
            {page.url.prev ? (
              <a rel="prev" href={page.url.prev}>Newer posts</a>
            ) : (
              <span aria-hidden="true" />
            )}
            <span aria-current="page">Page {pageNumber} of {page.lastPage}</span>
            {page.url.next ? (
              <a rel="next" href={page.url.next}>Older posts</a>
            ) : (
              <span aria-hidden="true" />
            )}
          </nav>
        )}
      </>
    )}
  </div>
</BlogLayout>
